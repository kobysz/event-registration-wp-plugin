{
  "name": "kuba/event-registration",
  "description": "Formularze rejestracji na wydarzenia dla WordPressa",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^1.1"
  },
  "autoload": {
    "psr-4": {
      "EvReg\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "EvReg\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
